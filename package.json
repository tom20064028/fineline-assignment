{
  "name": "document-publishing-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:api": "node --env-file-if-exists=.env --import tsx publishing-api/src/server.ts",
    "dev:source": "node --env-file-if-exists=.env --import tsx source-stub/src/server.ts",
    "dev:vendor": "node --env-file-if-exists=.env --import tsx vendor-stub/src/server.ts",
    "dev:frontend": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --config frontend/vite.config.ts",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc -p tsconfig.build.json",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p tests/e2e/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:manual": "node --import tsx tests/manual/server.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "start:api": "node --env-file-if-exists=.env dist/publishing-api/src/server.js",
    "start:source": "node --env-file-if-exists=.env dist/source-stub/src/server.js",
    "start:vendor": "node --env-file-if-exists=.env dist/vendor-stub/src/server.js",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.13.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
