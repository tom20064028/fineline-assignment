{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["shared/**/*.ts", "publishing-api/**/*.ts", "source-stub/**/*.ts", "vendor-stub/**/*.ts", "tests/**/*.ts", "vitest.config.ts"]
}
